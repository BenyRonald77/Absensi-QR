# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=absensi_training

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/absensi_training?schema=public

# API
API_PORT=3001
FRONTEND_URL=http://localhost:3000

# Authentication settings for the next project phase. Replace before deployment.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Web app
NEXT_PUBLIC_API_URL=http://localhost:3001/api
