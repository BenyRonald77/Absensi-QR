# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=absensi_training

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/absensi_training?schema=public

# API
API_PORT=3001
FRONTEND_URL=http://localhost:3000
# For phone testing over Wi-Fi, use comma-separated origins, for example:
# FRONTEND_URL=http://localhost:3000,http://192.168.1.10:3000

# Development-only JWT secrets. Replace both with random values outside local development.
JWT_ACCESS_SECRET=local-development-access-secret-change-before-deployment-9c3a2b78
JWT_REFRESH_SECRET=local-development-refresh-secret-change-before-deployment-4f71d0e6
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Web app
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# For phone testing, point this to the computer's LAN IP, for example:
# NEXT_PUBLIC_API_URL=http://192.168.1.10:3001/api
QR_TOKEN_INTERVAL_SECONDS=15
